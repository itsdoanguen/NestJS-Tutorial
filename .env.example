# Server
PORT=3000
NODE_ENV=development

# MySQL Database (Docker)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_NAME=nest_tutorial

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Upload
UPLOAD_DIR=storage
UPLOAD_MAX_FILE_SIZE=2097152
